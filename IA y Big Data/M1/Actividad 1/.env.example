# AM: PROJECT PROTOCOL - CONFIGURACIÓ DE VARIABLES D'ENTORN
# Copieu aquest arxiu a .env i inseriu les vostres claus si voleu utilitzar APIs de núvol.
# RECORDEU: MAI PUGEU LES VOSTRES CLAUS PRIVADES AL REPOSITORI GIT.

# Proveïdor d'IA seleccionat (local | gemini | openai)
AI_PROVIDER=local

# Google Gemini API Key (opcional, deixar buit per utilitzar el Motor Heurístic Autònom)
GEMINI_API_KEY=

# OpenAI API Key (opcional)
OPENAI_API_KEY=

# Port del servidor local de desenvolupament
SERVER_PORT=8000
